# ---------------------------------------------------------------------------
# The Wet Stack — Mireye frontend configuration
#
# Only non-secret values belong here: anything prefixed with VITE_ is compiled
# into the bundle and is visible to anyone using the app. API keys for Mireye,
# Supabase, Neo4j or the LLM live in the backend environment only.
# ---------------------------------------------------------------------------

# Leave empty for local development: Vite proxies /api to http://127.0.0.1:8000.
# Set to the deployed API origin for preview/production builds, e.g.
# VITE_API_BASE_URL=https://wetstack-api.onrender.com
VITE_API_BASE_URL=
