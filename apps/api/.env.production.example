# ---------------------------------------------------------------------------
# The Wet Stack — Mireye API: PRODUCTION environment
#
# These are the values to set in the Render dashboard (Environment tab), not in
# a committed file. Nothing here is a secret; every secret is marked `<...>` and
# is optional — the deployment runs in demo mode without any of them.
#
# Never commit a real .env. See docs/deployment.md.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
LOG_LEVEL=INFO

# --- REQUIRED --------------------------------------------------------------
# Exact browser origins allowed to call this API, comma separated.
# No wildcard: '*' is rejected by the application, not honoured.
# Include the Vercel production domain, and any custom domain you attach.
CORS_ORIGINS=https://wetstack-mireye.vercel.app

# --- Storage ---------------------------------------------------------------
# Render's filesystem is EPHEMERAL: this database is recreated on every deploy
# and every restart. Fine for the demo, not persistence. See docs/deployment.md.
DATA_DIR=/tmp/wetstack

# --- Demo data -------------------------------------------------------------
# Seeds the synthetic demo project when the store is empty, so a redeploy
# self-heals. MUST be false for any deployment with a real DATABASE_URL —
# synthetic engineering data must never enter a real database.
SEED_ON_STARTUP=true

# --- Optional live services ------------------------------------------------
# Leaving each of these unset keeps the deterministic local adapter, and the UI
# keeps showing the "Demo mode" banner naming what is simulated.
#
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>   # also enables pgvector
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role key — server side only, never sent to the browser>
#
# NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<password>
#
# MIREYE_BASE_URL=https://api.mireye.example
# MIREYE_API_KEY=<token>
MIREYE_TIMEOUT_SECONDS=12
MIREYE_MAX_RETRIES=2
MIREYE_CACHE_TTL_SECONDS=900
#
# ANTHROPIC_API_KEY=<key>
# ANTHROPIC_MODEL=claude-opus-5

# --- Uploads ---------------------------------------------------------------
# Uploaded PDFs are written under DATA_DIR/uploads and are also EPHEMERAL.
MAX_UPLOAD_BYTES=26214400
