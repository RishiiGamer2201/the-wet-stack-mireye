# ---------------------------------------------------------------------------
# The Wet Stack — Mireye API configuration
#
# EVERY value below is optional. With an empty file the application runs in
# deterministic demo mode: mock Mireye, in-memory graph, local vector index,
# SQLite storage and template-based explanations. Fill a section in to switch
# that one adapter to live mode; the rest keep their local implementation.
#
# Copy to `.env` (never commit `.env`).
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---------------------------------------------------------------
# Local default: SQLite at apps/api/var/wetstack.db
# DATA_DIR=./var
# SQLITE_PATH=./var/wetstack.db
#
# Live mode: a Postgres/Supabase connection string. Enables the pgvector
# retrieval index as well.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wetstack
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role key — server side only, never sent to the browser>

# --- Neo4j (impact graph) --------------------------------------------------
# Without these the in-memory graph store is used and traversal behaves identically.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=please-change-me

# --- Mireye ----------------------------------------------------------------
# Without these the deterministic mock adapter is used and every value it
# returns is labelled `synthetic` in the UI.
# MIREYE_BASE_URL=https://api.mireye.example
# MIREYE_API_KEY=<token>
MIREYE_TIMEOUT_SECONDS=12
MIREYE_MAX_RETRIES=2
MIREYE_CACHE_TTL_SECONDS=900

# --- LLM (optional) --------------------------------------------------------
# The LLM only plans investigations and explains findings. It never computes a
# score, a delta, a threshold or a decision state.
# LLM_PROVIDER=auto          # auto | anthropic | none
# ANTHROPIC_API_KEY=<key>
# ANTHROPIC_MODEL=claude-opus-5

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
