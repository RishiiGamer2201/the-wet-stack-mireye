# ---------------------------------------------------------------------------
# The Wet Stack — Mireye API configuration
#
# EVERY value below is optional. With an empty file the application runs in
# deterministic demo mode: mock Mireye, in-memory graph, local vector index,
# SQLite storage and template-based explanations. Fill a section in to switch
# that one adapter to live mode; the rest keep their local implementation.
#
# Copy to `.env` (never commit `.env`).
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---------------------------------------------------------------
# Local default: SQLite at apps/api/var/wetstack.db
# DATA_DIR=./var
# SQLITE_PATH=./var/wetstack.db
#
# Live mode: a Postgres/Supabase connection string. Enables the pgvector
# retrieval index as well.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wetstack
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role key — server side only, never sent to the browser>

# --- Neo4j (impact graph) --------------------------------------------------
# Without these the in-memory graph store is used and traversal behaves identically.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=please-change-me

# --- Mireye ----------------------------------------------------------------
# Without these the deterministic mock adapter is used and every value it
# returns is labelled `synthetic` in the UI.
# MIREYE_BASE_URL=https://api.mireye.example
# MIREYE_API_KEY=<token>
MIREYE_TIMEOUT_SECONDS=12
MIREYE_MAX_RETRIES=2
MIREYE_CACHE_TTL_SECONDS=900

# --- Demo data -------------------------------------------------------------
# Seeds the synthetic demo project when the store is empty. Default is false,
# so a fresh database starts empty until you POST /api/admin/seed.
# SEED_ON_STARTUP=true

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# --- OCR -------------------------------------------------------------------
# Only pages with *no text layer* are OCR'd, so a normal PDF costs nothing.
# Needs the `tesseract` binary on the host (apt: tesseract-ocr tesseract-ocr-eng;
# Windows: the UB Mannheim installer; macOS: brew install tesseract). Without it
# a scan is reported as unreadable rather than silently producing nothing.
#
# Anything OCR reads is a *transcription*: it is marked at the page, the
# requirement and the evidence, carried at half confidence, and flagged for a
# human read before any check can use it.
# OCR_ENABLED=true
# Set these only when tesseract is installed somewhere the probe misses.
# OCR_TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# OCR_TESSDATA_DIR=C:/Program Files/Tesseract-OCR/tessdata
# ~1-3 s per page. Scans past this limit are reported as unread, not attempted.
# OCR_MAX_PAGES=30
# OCR_DPI=200

# --- Mireye live-cost guardrails -------------------------------------------
# Mireye bills per field per location. Reaching a limit records a visible
# information gap for the sites that were not queried; it never fails the run
# and never downgrades evidence silently. Mock mode is free and unbounded.
# MIREYE_MAX_LIVE_LOCATIONS=3     # locations one investigation may fetch live
# MIREYE_MAX_LIVE_FETCHES=8       # live /v1/fetch calls per investigation
# MIREYE_INCLUDE_PARCEL_FIELDS=false   # 300 credits/location — keep off
# MIREYE_ENABLE_FEATURE_REQUESTS=false # /v1/feature-requests is unverified;
#                                      # gaps are recorded locally until it is confirmed

# --- LLM provider ----------------------------------------------------------
# auto = OpenAI when OPENAI_API_KEY is set, else Gemini. Name one explicitly to
# force it. 'none' disables the model without deleting a key.
# The model only plans and explains; no score, delta, threshold or decision
# state ever comes from it (enforced by tests/test_llm.py).
LLM_PROVIDER=auto              # auto | openai | gemini | none

# OpenAI - verified working on gpt-5.1 via the /v1/responses API.
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-5.1
#   Check what your account actually has:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
#   Some models (gpt-5-mini) need organisation verification first.

# Gemini - free tier, an alternative to OpenAI.
# GEMINI_API_KEY=<key>         # aistudio.google.com
# GEMINI_MODEL=gemini-3.6-flash
#   Pin a version. `gemini-flash-latest` moves under you, and gemini-2.0-flash
#   is already retired (the API answers 404 telling you to upgrade).

# --- Tracing (LangSmith, optional) -----------------------------------------
# Off unless a key is set. The workflow runs on LangGraph, so a key is all that
# is needed to see every Understand -> ... -> Action run as a trace tree.
# LANGSMITH_API_KEY=<key>      # smith.langchain.com - free tier
# LANGSMITH_PROJECT=wetstack-mireye
